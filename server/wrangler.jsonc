{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Serveur multijoueur des Chroniques de Valdorne : le jeu (fichiers statiques) et le monde partagé (Durable Object)
  "name": "valdorne",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "observability": { "enabled": true }
}
