{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Serveur multijoueur des Chroniques de Valdorne : le jeu (fichiers intégrés au Worker) et le monde partagé (Durable Object)
  "name": "valdorne",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  // une seule adresse publique : https://valdorne.<sous-domaine>.workers.dev
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "observability": { "enabled": true }
}
